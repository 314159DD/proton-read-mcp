# Proton Bridge credentials (use the BRIDGE password, not your Proton login)
PROTONMAIL_USERNAME=you@pm.me

# Prefer a file so the secret never sits in shell history or config:
PROTONMAIL_PASSWORD_FILE=/home/you/.proton-bridge-pass
# ...or inline (less safe):
# PROTONMAIL_PASSWORD=your-bridge-password

# Where Bridge's IMAP listens. On the VPS where Bridge runs: 127.0.0.1.
# On the Mac via SSH tunnel: also 127.0.0.1 (the tunnel's local end).
PROTONMAIL_IMAP_HOST=127.0.0.1
PROTONMAIL_IMAP_PORT=1143
